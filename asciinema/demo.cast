[0.008, "o", "\u001b[?2026h\u001b[1;51r\u001b[H\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[3M\u001b[r\u001b[1;3H\u001b(B\u001b[m\u001b[38:2:192:202:245m\u001b[48:2:26:27:38m166 \r\u001b[48B\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m212 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m      assert.strictEqual(res.body?.error?.code, \u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38m\"INVALID_CREDENTIALS\"\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m213 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m    \u001b(B\u001b[m\u001b[38:2:42:195:222m\u001b[48:2:26:27:38m}\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m);\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m214 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[K\u001b[52;101H\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:50:51:62m6\u001b[1;51r\u001b[H\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[3M\u001b[r\u001b[1;3H\u001b(B\u001b[m\u001b[38:2:192:202:245m\u001b[48:2:26:27:38m169 \r\u001b[48B\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m215 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m    it(\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38m\"authenticates valid credentials and issues a JWT (Valid Login / Login - Valid)\"\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m, \u001b(B\u001b[m\u001b[38:2:187:154:247m\u001b[48:2:26:27:38masync\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m () \u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m    \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m=> \u001b(B\u001b[m\u001b[38:2:42:195:222m\u001b[48:2:26:27:38m{\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m216 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m      \u001b(B\u001b[m\u001b[38:2:187:154:247m\u001b[48:2:26:27:38mconst\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m res = \u001b(B\u001b[m\u001b[38:2:115:218:202m\u001b[48:2:26:27:38mawait\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m request(\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38m\"/api/auth/login\"\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m, \u001b(B\u001b[m\u001b[38:2:42:195:222m\u001b[48:2:26:27:38m{\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[K\u001b[52;101H\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:50:51:62m9\u001b[1;51r\u001b[H\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[3M\u001b[r\u001b[1;3H\u001b(B\u001b[m\u001b[38:2:192:202:245m\u001b[48:2:26:27:38m172 \r\u001b[48B\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m217 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m        method: \u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38m\"POST\"\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m,\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m218 \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m        body: \u001b(B\u001b[m\u001b[38:2:42:195:222m\u001b[48:2:26:27:38m{\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64