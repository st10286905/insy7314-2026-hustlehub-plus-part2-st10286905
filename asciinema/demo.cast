[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n\u001b[1mTest 1: Reject registration with invalid email (Register - Invalid Email)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n\u001b[0;36m\u001b[1m> REQUEST\u001b[0m\r\n  \u001b[1mEndpoint:\u001b[0m POST https://localhost:3000/api/auth/register\r\n  \u001b[1mHeaders:\u001b[0m  Content-Type: application/json\r\n"]
[0.000, "o", "  \u001b[1mPayload:\u001b[0m\r\n"]
[0.001, "o", "    {\r\n      \"email\": \"not-an-email\",\r\n      \"password\": \"SecurePassword123!\",\r\n      \"role\": \"freelancer\"\r\n    }\r\n"]
[0.018, "o", "\r\n\u001b[0;33m\u001b[1m< RESPONSE\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1mHTTP Status:\u001b[0m 400\r\n"]
[0.000, "o", "  \u001b[1mBody:\u001b[0m\r\n"]
[0.000, "o", "    {\r\n      \"error\": {\r\n        \"code\": \"VALIDATION_ERROR\",\r\n        \"message\": \"Invalid request data\",\r\n        \"details\": [\r\n          {\r\n            \"field\": \"email\",\r\n            \"message\": \"Email must be a valid email address\"\r\n          }\r\n        ]\r\n      }\r\n    }\r\n"]
[0.000, "o", "\r\n  \u001b[0;32m\u001b[1m  PASS\u001b[0m (HTTP 400 matched expected 400)\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n\u001b[1mTest 2: Reject registration with weak password (Register - Weak Password)\u001b[0m\r\n"]
[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n\u001b[0;36m\u001b[1m> REQUEST\u001b[0m\r\n"]
[0.000, "o", "  \u001b[1mEndpoint:\u001b[0m POST https://localhost:3000/api/auth/register\r\n"]
[0.000, "o", "  \u001b[1mHeaders:\u001b[0m  Content-Type: application/json\r\n  \u001b[1mPayload:\u001b[0m\r\n    {\r\n      \"email\": \"test_1788811254@hustlehub.co.za\",\r\n      \"password\": \"123\",\r\n      \"role\": \"freelancer\"\r\n    }\r\n"]
[0.002, "o", "\r\n\u001b[0;33m\u001b[1m< RESPONSE\u001b[0m\r\n  \u001b[1mHTTP Status:\u001b[0m 400\r\n"]
[0.000, "o", "  \u001b[1mBody:\u001b[0m\r\n"]
[0.000, "o", "    {\r\n      \"error\": {\r\n        \"code\": \"VALIDATION_ERROR\",\r\n        \"message\": \"Invalid request data\",\r\n        \"details\": [\r\n          {\r\n            \"field\": \"password\",\r\n            \"message\": \"Password must be complex and between 8 to 128 characters\"\r\n          }\r\n        ]\r\n      }\r\n    }\r\n"]
[0.000, "o", "\r\n  \u001b[0;32m\u001b[1m  PASS\u001b[0m (HTTP 400 matched expected 400)\r\n\r\n"]
[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n\u001b[1mTest 3: Reject registration with missing email (Register - Missing Email)\u001b[0m\r\n"]
