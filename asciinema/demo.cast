[0.006, "o", "\u001b[?2026h\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:192:202:245m\u001b[48:2:26:27:38m 1 \u001b(B\u001b[m\u001b[38:2:192:202:245m\u001b[48:2:64:72:106m{\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m 2 \u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\"\u001b(B\u001b[m\u001b[38:2:13:185:215m\u001b[48:2:26:27:38mname\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\": \"\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38mhustlehub-plus_backend\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\",\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m 3 \u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\"\u001b(B\u001b[m\u001b[38:2:13:185:215m\u001b[48:2:26:27:38mversion\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\": \"\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38m1.0.0\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\",\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\u001b[48:2:26:27:38m 4 \u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\"\u001b(B\u001b[m\u001b[38:2:13:185:215m\u001b[48:2:26:27:38mdescription\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\": \"\u001b(B\u001b[m\u001b[38:2:158:206:106m\u001b[48:2:26:27:38mThe backend API for HustleHub+\u001b(B\u001b[m\u001b[38:2:169:177:214m\u001b[48:2:26:27:38m\",\u001b[K\r\n\u001b(B\u001b[m\u001b[38:2:68:75:106m\u001b[48:2:26:27:38m  \u001b(B\u001b[m\u001b[38:2:64:72:106m\