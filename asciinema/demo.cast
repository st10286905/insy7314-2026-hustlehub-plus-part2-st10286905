[0.037, "o", "\u001b[1mStarting integration test runner\u001b[0m\r\nServer ready at https://localhost:3000 \u001b[0;32m[READY]\u001b[0m (PID: 447346)\r\n\r\n"]
[0.000, "o", "\u001b[1m--- Starting Integration Test Suite ---\u001b[0m\r\n\r\n"]
[0.000, "o", "\u001b[1m\u001b[0;34m------------------------------------------------------------\u001b[0m\r\n"]
[0.000, "o", "\u001b[1mTest 1: Reject registration with invalid email (Register - Invalid Email)\u001b[0m\r\n"]
